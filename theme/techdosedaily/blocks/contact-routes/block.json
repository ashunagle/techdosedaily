{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/contact-routes",
	"title": "Contact routes",
	"category": "techdosedaily",
	"description": "Contact routes (editorial, corrections, tips, partnerships…) linking to the Contact page.",
	"textdomain": "techdosedaily",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [
				"full",
				"compact"
			],
			"default": "compact"
		},
		"only": {
			"type": "array",
			"default": [
				"editorial",
				"correction",
				"tip",
				"partnership"
			]
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "tdd-editor-blocks"
}
