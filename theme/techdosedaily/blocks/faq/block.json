{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/faq",
	"title": "FAQ",
	"category": "techdosedaily",
	"description": "Questions and answers (native disclosure; first item open).",
	"textdomain": "techdosedaily",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Questions"
		},
		"rows": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"multiple": false
	},
	"render": "file:./render.php",
	"editorScript": "tdd-editor-blocks"
}
