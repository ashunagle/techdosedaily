{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/latest-feed",
	"title": "Latest Updates",
	"category": "techdosedaily",
	"description": "Timestamped newsroom stream (LatestUpdateRow) with heading, freshness line and \"All latest →\".",
	"textdomain": "techdosedaily",
	"attributes": {
		"count": {
			"type": "integer",
			"default": 7
		},
		"section": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": "Latest Updates"
		},
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"moreButton": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php"
}
