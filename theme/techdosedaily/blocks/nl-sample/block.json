{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/nl-sample",
	"title": "Newsletter preview",
	"category": "techdosedaily",
	"description": "“A look inside”: today’s real Daily Tech Brief stories in the issue frame. Hidden below three stories.",
	"textdomain": "techdosedaily",
	"attributes": {
		"title": {
			"type": "string",
			"default": "A look inside"
		},
		"how": {
			"type": "string",
			"default": ""
		},
		"delivery": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"multiple": false
	},
	"render": "file:./render.php",
	"editorScript": "tdd-editor-blocks"
}
