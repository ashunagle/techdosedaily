{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/policy-callout",
	"title": "Policy callout",
	"category": "techdosedaily",
	"description": "“In short” summary (primary) or a neutral disclosure box. Contains paragraphs or one list.",
	"textdomain": "techdosedaily",
	"attributes": {
		"title": {
			"type": "string",
			"default": "In short"
		},
		"neutral": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "tdd-editor-blocks"
}
