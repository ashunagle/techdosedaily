{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/policy-notice",
	"title": "Policy notice",
	"category": "techdosedaily",
	"description": "An important rule, or “What changed on …”. Bold title plus one short paragraph.",
	"textdomain": "techdosedaily",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"change": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "tdd-editor-blocks"
}
