{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tdd/section-heading",
	"title": "Section heading",
	"category": "techdosedaily",
	"description": "Design-system SectionHeading: title, optional description or freshness line, optional \"View all \u2192\" link.",
	"textdomain": "techdosedaily",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"default": "default"
		},
		"fresh": {
			"type": "boolean",
			"default": false
		},
		"level": {
			"type": "string",
			"default": "h2"
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php"
}
